# 複製成 .env 後依主機修改(.env 不進 Git,權限請設 600)
#   cp .env.example .env && chmod 600 .env

# RCON 密碼：填隨機長字串(openssl rand -hex 24)
RCON_PASSWORD=

# 伺服器檔案的擁有者，填主機上管理員帳號的 `id -u` / `id -g`
MC_UID=1002
MC_GID=1002

# 對外 port(容器內一律 25565)
MC_PORT=25566
MIRROR_PORT=25567

# 記憶體:MEMORY 是 Java heap,MEM_LIMIT 是容器上限(建議比 heap 多約 25%)
MC_MEMORY=10G
MC_MEM_LIMIT=13g
MIRROR_MEMORY=6G
MIRROR_MEM_LIMIT=8g
